#!/usr/bin/env python3
"""Яркость внешнего монитора через DDC/CI.

    monitor-brightness up          — шаг вверх
    monitor-brightness down        — шаг вниз
    monitor-brightness hold up     — шаг, затем автоповтор, пока держат
    monitor-brightness release     — отпустили клавишу, остановить автоповтор
    monitor-brightness set 50      — выставить значение
    monitor-brightness get         — спросить монитор

Зачем файл состояния. Чтение яркости у монитора занимает ~0,6 с, запись
~0,3 с. Если спрашивать монитор на каждый шаг, клавиша будет ощутимо
тормозить, а при удержании — захлёбываться. Поэтому желаемое значение
живёт в файле: шаг мгновенно сдвигает его и показывает уведомление,
а записью занимается отдельный исполнитель, догоняя цель. Сколько бы
шагов ни пришло, монитору уйдёт столько записей, сколько он успеет
переварить.

Две блокировки, а не одна. Шаги приходят чаще, чем монитор отвечает,
поэтому работа идёт одновременно. `state.lock` держится микросекунды
и защищает чтение-изменение-запись цели: без него два шага прочитают
одно и то же значение и один из них потеряется. `apply.lock` держится
всю запись в монитор, и его ждут, а не пропускают: иначе бывает так, что
исполнитель в последний раз прочитал цель, в этот момент пришёл новый
шаг — и новичок, застав блокировку занятой, ушёл, а исполнитель, уже
прочитавший старую цель, вышел следом. Значение терялось молча.
Поэтому очередь ждут и сверяются с тем, что реально отправлено в монитор
(файл `applied`).

Автоповтор. Перенаправленная через Solaar клавиша сама не повторяется:
нажатие и отпускание — два отдельных события, между ними тишина. Поэтому
повтор делаем сами: `hold` ставит отметку и крутит шаги, пока отметка
на месте, `release` её убирает. Если событие отпускания потеряется,
цикл всё равно остановится — по `BRIGHTNESS_HOLD_MAX_SEC`.
"""
import contextlib
import fcntl
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

STEP = int(os.environ.get("BRIGHTNESS_STEP", "5"))
RESYNC_SEC = float(os.environ.get("BRIGHTNESS_RESYNC_SEC", "60"))
HOLD_DELAY_SEC = float(os.environ.get("BRIGHTNESS_HOLD_DELAY_SEC", "0.35"))
HOLD_EVERY_SEC = float(os.environ.get("BRIGHTNESS_HOLD_EVERY_SEC", "0.07"))
HOLD_MAX_SEC = float(os.environ.get("BRIGHTNESS_HOLD_MAX_SEC", "8"))
BAR_CELLS = int(os.environ.get("BRIGHTNESS_BAR_CELLS", "20"))
NOTIFY_REUSE_SEC = float(os.environ.get("BRIGHTNESS_NOTIFY_REUSE_SEC", "4"))
VCP = "10"  # Brightness

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "monitor-brightness"
TARGET = RUNTIME / "target"
APPLIED = RUNTIME / "applied"
HOLD = RUNTIME / "hold"
BUS = RUNTIME / "bus"
STATE_LOCK = RUNTIME / "state.lock"
APPLY_LOCK = RUNTIME / "apply.lock"
HOLD_LOCK = RUNTIME / "hold.lock"
NOTIFY_ID = RUNTIME / "notify-id"


@contextlib.contextmanager
def flock(path, blocking=True):
    """Отдаёт True, если блокировка взята."""
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        mode = fcntl.LOCK_EX if blocking else fcntl.LOCK_EX | fcntl.LOCK_NB
        try:
            fcntl.flock(fd, mode)
        except OSError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


_bus = None


def bus():
    """Номер шины I2C монитора. Определяется один раз: detect медленный."""
    global _bus
    if _bus is not None:
        return _bus
    with contextlib.suppress(OSError):
        cached = BUS.read_text().strip()
        if cached:
            _bus = cached
            return _bus
    out = subprocess.run(["ddcutil", "detect", "--brief"], capture_output=True,
                         text=True, timeout=90).stdout
    found = re.search(r"^\s*I2C bus:\s*/dev/i2c-(\d+)", out, re.M)
    if not found:
        raise RuntimeError("ddcutil detect не нашёл монитор с DDC/CI")
    _bus = found.group(1)
    with contextlib.suppress(OSError):
        BUS.write_text(_bus)
    return _bus


def ddcutil(*args, timeout=20):
    """ddcutil сыплет трассировкой, поэтому разбираем только stdout."""
    cmd = ["ddcutil", "--bus", bus()] + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        raise RuntimeError(f"ddcutil {' '.join(args)}: код {r.returncode}\n{r.stderr.strip()}")
    return r.stdout


def read_monitor():
    out = ddcutil("getvcp", VCP, "--brief")
    m = re.search(rf"VCP\s+{VCP}\s+C\s+(\d+)\s+(\d+)", out)
    if not m:
        raise RuntimeError(f"не разобрал ответ монитора: {out.strip()!r}")
    return int(m.group(1)), int(m.group(2))


def write_atomic(path, text):
    tmp = path.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def current_target():
    """Цель из файла; если его нет или он залежался — спрашиваем монитор."""
    try:
        if time.time() - TARGET.stat().st_mtime < RESYNC_SEC:
            return int(TARGET.read_text().strip())
    except (OSError, ValueError):
        pass
    value = read_monitor()[0]
    write_atomic(APPLIED, str(value))
    return value


def bar(value):
    """Полоска из блоков: уведомление GNOME не умеет рисовать прогресс сам."""
    filled = round(value * BAR_CELLS / 100)
    return "█" * filled + "░" * (BAR_CELLS - filled)


def notify(value):
    # Срочность именно normal: при low GNOME вообще не показывает плашку —
    # уведомление молча уходит в никуда, а с ключом -e ещё и мимо истории.
    # Подсказку int:value GNOME игнорирует, поэтому полоску рисуем сами.
    cmd = ["notify-send", "-a", "Яркость", "-u", "normal", "-e", "-p",
           "-i", "display-brightness-symbolic"]
    # -r заменяет плашку на месте, чтобы при удержании они не копились.
    # Но номер годится только пока плашка жива: если подсунуть GNOME номер
    # давно погасшего уведомления, он обновит то, чего нет, и не покажет
    # ничего. Поэтому переиспользуем номер лишь несколько секунд.
    with contextlib.suppress(OSError, ValueError):
        prev, at = NOTIFY_ID.read_text().split()
        if prev.isdigit() and time.time() - float(at) < NOTIFY_REUSE_SEC:
            cmd += ["-r", prev]
    cmd += [f"Яркость монитора   {value}%", bar(value)]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
        if out.isdigit():
            write_atomic(NOTIFY_ID, f"{out} {time.time():.3f}")
    except Exception:
        pass


def apply_until_settled():
    """Ждём очереди и догоняем цель, если её ещё не отправили в монитор."""
    with flock(APPLY_LOCK) as mine:
        assert mine
        try:
            written = int(APPLIED.read_text().strip())
        except (OSError, ValueError):
            written = None
        while True:
            try:
                want = int(TARGET.read_text().strip())
            except (OSError, ValueError):
                return
            if want == written:
                return
            ddcutil("setvcp", VCP, str(want))
            written = want
            write_atomic(APPLIED, str(written))


def bump(direction):
    """Сдвигает цель на шаг и показывает её. В монитор не пишет."""
    with flock(STATE_LOCK) as mine:
        assert mine
        delta = STEP if direction == "up" else -STEP
        want = max(0, min(100, current_target() + delta))
        write_atomic(TARGET, str(want))
    notify(want)
    return want


def holding(direction):
    try:
        return HOLD.read_text().strip() == direction
    except OSError:
        return False


def hold(direction):
    """Шаг сразу, дальше автоповтор, пока отметка удержания на месте."""
    write_atomic(HOLD, direction)
    with flock(HOLD_LOCK, blocking=False) as mine:
        if not mine:
            return  # повторитель уже крутится, ему и достанется отметка
        stop = threading.Event()

        def worker():
            # Пишет в монитор, пока идут шаги: цикл шагов его не ждёт,
            # иначе период упёрся бы в 0,3 с на запись.
            while not stop.is_set():
                apply_until_settled()
                stop.wait(0.02)

        applier = threading.Thread(target=worker, daemon=True)
        applier.start()
        try:
            value = bump(direction)
            deadline = time.monotonic() + HOLD_MAX_SEC
            time.sleep(HOLD_DELAY_SEC)
            while holding(direction) and time.monotonic() < deadline:
                if value in (0, 100):
                    break  # упёрлись в край, дальше повторять нечего
                value = bump(direction)
                time.sleep(HOLD_EVERY_SEC)
        finally:
            stop.set()
            applier.join(timeout=HOLD_MAX_SEC)
            apply_until_settled()


def release():
    with contextlib.suppress(OSError):
        HOLD.unlink()


def main():
    RUNTIME.mkdir(parents=True, exist_ok=True)
    arg = sys.argv[1] if len(sys.argv) > 1 else "get"

    if arg == "get":
        value, maximum = read_monitor()
        print(f"{value}/{maximum}")
        return 0

    if arg == "release":
        release()
        return 0

    if arg == "hold":
        direction = sys.argv[2]
        if direction not in ("up", "down"):
            print(__doc__.strip(), file=sys.stderr)
            return 2
        hold(direction)
        return 0

    if arg in ("up", "down"):
        bump(arg)
        apply_until_settled()
        return 0

    if arg == "set":
        with flock(STATE_LOCK) as mine:
            assert mine
            want = max(0, min(100, int(sys.argv[2])))
            with contextlib.suppress(OSError):
                APPLIED.unlink()
            write_atomic(TARGET, str(want))
        notify(want)
        apply_until_settled()
        return 0

    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"яркость: {exc}", file=sys.stderr)
        subprocess.run(["notify-send", "-a", "Яркость", "-u", "critical", "-e",
                        "Яркость монитора", str(exc)], check=False)
        sys.exit(1)
